# ============================================================
# ReAnote — .gitignore
#
# This repo ships CODE and DOCUMENTATION only. Every heavy/generated/
# user-specific item below lives on the portable disk but must never be
# committed — see INSTALLING_DATA.md for how to reconstruct data/ and
# engine/ from scratch.
# ============================================================

# ---- Reference data + annotation sources (hundreds of GB, see INSTALLING_DATA.md) ----
/data/

# ---- Packaged runtime environments (conda-pack tarballs/SquashFS images) ----
/engine/

# ---- User input/output — not part of the repo, generated/provided at runtime ----
/input/
/outputs/

# ---- Logs and runtime state generated by ReAnote_GUI.ps1 ----
/logs/

# ---- Rendered manual output (regenerate from USER_MANUAL.Rmd via Knit) ----
USER_MANUAL.html
USER_MANUAL.pdf

# ---- Editor/session artifacts ----
.Rhistory
.Rproj.user/
*.Rproj

# ---- Personal scratch notes (not part of the documented workflow) ----
Montar.txt

# ---- OS/editor cruft ----
.DS_Store
Thumbs.db
*.swp
